/* ============================================================
   TaxAdmin – Qt Style Sheet
   Design: Stripe / Linear / Fluent inspired
   Primary: #2563EB  Background: #F8FAFC  Card: #FFFFFF
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    font-family: "Segoe UI", "Inter", "SF Pro Text", Arial, sans-serif;
    font-size: 13px;
    color: #1e293b;
    background-color: transparent;
}

QMainWindow, QDialog {
    background-color: #f8fafc;
}

/* ── Scrollbars ──────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 4px;
    min-width: 30px;
}

/* ── Sidebar ─────────────────────────────────────────────── */
#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
    min-width: 240px;
    max-width: 240px;
}

#SidebarLogo {
    font-size: 16px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.3px;
}

#SidebarLogoAccent {
    color: #2563eb;
}

#NavButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    color: #64748b;
}
#NavButton:hover {
    background-color: #f1f5f9;
    color: #1e293b;
}
#NavButton[active="true"] {
    background-color: #eff6ff;
    color: #2563eb;
    font-weight: 600;
}

#SidebarSection {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #94a3b8;
    padding: 4px 12px 8px;
}

#SidebarUserCard {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px;
}

#SidebarUserName {
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
}

#SidebarUserEmail {
    font-size: 11px;
    color: #94a3b8;
}

#LogoutButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    color: #dc2626;
}
#LogoutButton:hover {
    background-color: #fef2f2;
}

/* ── Header ──────────────────────────────────────────────── */
#TopHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    min-height: 56px;
    max-height: 56px;
}

#PageTitleLabel {
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.2px;
}

#SearchBar {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 10px 6px 32px;
    font-size: 13px;
    color: #1e293b;
    min-width: 220px;
}
#SearchBar:focus {
    background-color: #ffffff;
    border-color: #2563eb;
    outline: none;
}

/* ── Content area ────────────────────────────────────────── */
#ContentArea {
    background-color: #f8fafc;
}

#PageScrollArea {
    background-color: #f8fafc;
    border: none;
}

#PageScrollArea > QWidget {
    background-color: #f8fafc;
}

/* ── Cards ───────────────────────────────────────────────── */
#Card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 0px;
}

#KpiCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
}
#KpiCard:hover {
    border-color: #bfdbfe;
}

#KpiValue {
    font-size: 28px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.5px;
}

#KpiLabel {
    font-size: 13px;
    font-weight: 500;
    color: #374151;
}

#KpiDescription {
    font-size: 11px;
    color: #94a3b8;
}

#TrendUp {
    background-color: #dcfce7;
    color: #16a34a;
    border-radius: 10px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

#TrendDown {
    background-color: #fee2e2;
    color: #dc2626;
    border-radius: 10px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

/* ── Icon containers ─────────────────────────────────────── */
#IconBlue {
    background-color: #dbeafe;
    border-radius: 10px;
    padding: 10px;
}
#IconGreen {
    background-color: #dcfce7;
    border-radius: 10px;
    padding: 10px;
}
#IconOrange {
    background-color: #fef3c7;
    border-radius: 10px;
    padding: 10px;
}
#IconRed {
    background-color: #fee2e2;
    border-radius: 10px;
    padding: 10px;
}
#IconPurple {
    background-color: #f3e8ff;
    border-radius: 10px;
    padding: 10px;
}
#IconDark {
    background-color: #e0e7ff;
    border-radius: 10px;
    padding: 10px;
}

/* ── Buttons ─────────────────────────────────────────────── */
#PrimaryButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}
#PrimaryButton:hover {
    background-color: #1d4ed8;
}
#PrimaryButton:pressed {
    background-color: #1e40af;
}
#PrimaryButton:disabled {
    background-color: #93c5fd;
}

#SecondaryButton {
    background-color: #ffffff;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    min-height: 36px;
}
#SecondaryButton:hover {
    background-color: #f9fafb;
    border-color: #9ca3af;
}
#SecondaryButton:pressed {
    background-color: #f3f4f6;
}

#DangerButton {
    background-color: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}
#DangerButton:hover {
    background-color: #b91c1c;
}
#DangerButton:pressed {
    background-color: #991b1b;
}

#GhostButton {
    background-color: transparent;
    color: #2563eb;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 30px;
}
#GhostButton:hover {
    background-color: #eff6ff;
}

#IconButton {
    background-color: transparent;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
}
#IconButton:hover {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
}

/* ── Form controls ───────────────────────────────────────── */
QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    color: #1e293b;
    selection-background-color: #dbeafe;
}
QLineEdit:focus, QTextEdit:focus {
    border-color: #2563eb;
    outline: none;
}
QLineEdit:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
}
QLineEdit::placeholder {
    color: #9ca3af;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 7px 30px 7px 10px;
    font-size: 13px;
    color: #1e293b;
    min-height: 34px;
}
QComboBox:hover {
    border-color: #9ca3af;
}
QComboBox:focus {
    border-color: #2563eb;
}
QComboBox::drop-down {
    border: none;
    width: 28px;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    selection-background-color: #eff6ff;
    selection-color: #2563eb;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QCheckBox {
    font-size: 13px;
    color: #374151;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #d1d5db;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}
QCheckBox::indicator:hover {
    border-color: #2563eb;
}

QLabel#FieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 4px;
}

/* ── Table ───────────────────────────────────────────────── */
QTableWidget {
    background-color: #ffffff;
    border: none;
    gridline-color: #f1f5f9;
    font-size: 13px;
    color: #1e293b;
    alternate-background-color: #f8fafc;
    selection-background-color: #eff6ff;
    selection-color: #1e293b;
    outline: none;
}

QTableWidget::item {
    padding: 10px 12px;
    border-bottom: 1px solid #f1f5f9;
}

QTableWidget::item:selected {
    background-color: #eff6ff;
    color: #1e293b;
}

QTableWidget::item:hover {
    background-color: #f8fafc;
}

QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #f1f5f9;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView::section:hover {
    background-color: #f1f5f9;
}

/* ── Dialogs ─────────────────────────────────────────────── */
#DialogBase {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
}

#DialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.3px;
}

#DialogSubtitle {
    font-size: 13px;
    color: #64748b;
}

#DialogSeparator {
    background-color: #e2e8f0;
    max-height: 1px;
    min-height: 1px;
}

/* ── Status badges ───────────────────────────────────────── */
#BadgeActive, #BadgeValidated {
    background-color: #dcfce7;
    color: #16a34a;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#BadgeSuspended, #BadgeDraft, #BadgeWarning {
    background-color: #fef3c7;
    color: #92400e;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#BadgeDeregistered, #BadgeRejected, #BadgeDanger {
    background-color: #fee2e2;
    color: #dc2626;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#BadgeSubmitted, #BadgeInfo {
    background-color: #dbeafe;
    color: #1d4ed8;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#BadgeSuccess {
    background-color: #dcfce7;
    color: #16a34a;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* ── Page header ─────────────────────────────────────────── */
#PageHeader {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px 24px;
}

#PageHeaderTitle {
    font-size: 22px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.4px;
}

#PageHeaderDescription {
    font-size: 13px;
    color: #64748b;
}

/* ── Greeting banner ─────────────────────────────────────── */
#GreetingBanner {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px 24px;
}

#GreetingTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.3px;
}

#GreetingSubtitle {
    font-size: 13px;
    color: #64748b;
}

#ClockBox {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 14px;
}

#ClockDate {
    font-size: 11px;
    color: #94a3b8;
}

#ClockTime {
    font-size: 17px;
    font-weight: 700;
    font-family: "Consolas", "Courier New", monospace;
    color: #1e293b;
}

/* ── Section titles ──────────────────────────────────────── */
#SectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.2px;
}

/* ── Alert cards ─────────────────────────────────────────── */
#AlertWarning {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 10px;
    padding: 10px 14px;
}

#AlertDanger {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 10px;
    padding: 10px 14px;
}

#AlertWarningLabel {
    color: #92400e;
    font-size: 13px;
    font-weight: 500;
}

#AlertDangerLabel {
    color: #991b1b;
    font-size: 13px;
    font-weight: 500;
}

/* ── Activity feed ───────────────────────────────────────── */
#ActivityItem {
    background-color: #ffffff;
    border: 1px solid #f1f5f9;
    border-radius: 10px;
    padding: 10px 12px;
}

#ActivityTitle {
    font-size: 13px;
    font-weight: 500;
    color: #1e293b;
}

#ActivityMeta {
    font-size: 11px;
    color: #94a3b8;
}

/* ── Pagination ──────────────────────────────────────────── */
#PaginationButton {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
    color: #374151;
    min-width: 32px;
    min-height: 30px;
}
#PaginationButton:hover {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
}
#PaginationButton[current="true"] {
    background-color: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
}
#PaginationButton:disabled {
    background-color: #f9fafb;
    color: #d1d5db;
}

#PaginationInfo {
    font-size: 12px;
    color: #64748b;
}

/* ── Tab bar ─────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #64748b;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #2563eb;
    border-bottom-color: #2563eb;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #374151;
}

/* ── Settings ────────────────────────────────────────────── */
#SettingsCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
}

#SettingRow {
    border-bottom: 1px solid #f1f5f9;
    padding: 12px 0;
}

#SettingLabel {
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
}

#SettingDescription {
    font-size: 12px;
    color: #94a3b8;
}

/* ── Notification toast ──────────────────────────────────── */
#ToastSuccess {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 10px;
    padding: 12px 16px;
}

#ToastError {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 10px;
    padding: 12px 16px;
}

#ToastInfo {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    padding: 12px 16px;
}

#ToastText {
    font-size: 13px;
    font-weight: 500;
    color: #1e293b;
}

/* ── Loading ─────────────────────────────────────────────── */
#LoadingLabel {
    font-size: 13px;
    color: #94a3b8;
}

/* ── Empty state ─────────────────────────────────────────── */
#EmptyStateTitle {
    font-size: 15px;
    font-weight: 600;
    color: #374151;
}
#EmptyStateDescription {
    font-size: 13px;
    color: #9ca3af;
}

/* ── Quick actions ───────────────────────────────────────── */
#QuickActionButton {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
    font-size: 13px;
    font-weight: 500;
    color: #374151;
    text-align: left;
}
#QuickActionButton:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
}

/* ── Reports ─────────────────────────────────────────────── */
#StatNumber {
    font-size: 22px;
    font-weight: 700;
    color: #1e293b;
}
#StatLabel {
    font-size: 12px;
    color: #64748b;
}

/* ── Login page ──────────────────────────────────────────── */
#LoginCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 40px;
}

#LoginTitle {
    font-size: 24px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.4px;
}

#LoginSubtitle {
    font-size: 13px;
    color: #64748b;
}

#LoginBrandPanel {
    border-radius: 16px;
    padding: 40px;
}

#LoginBrandTitle {
    font-size: 30px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.5px;
}

#LoginBrandSubtitle {
    font-size: 14px;
    color: rgba(255,255,255,0.80);
}

#LoginBrandFeature {
    font-size: 13px;
    color: rgba(255,255,255,0.90);
    font-weight: 500;
}

#LoginFooter {
    font-size: 11px;
    color: #94a3b8;
}

/* ── Avatar ──────────────────────────────────────────────── */
#AvatarCircle {
    background-color: #2563eb;
    border-radius: 18px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

#AvatarText {
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
}

/* ── Audit timeline ──────────────────────────────────────── */
#AuditRow {
    background-color: #ffffff;
    border: 1px solid #f1f5f9;
    border-radius: 10px;
    padding: 12px 14px;
}

#AuditAction {
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
}

#AuditDescription {
    font-size: 12px;
    color: #64748b;
}

#AuditMeta {
    font-size: 11px;
    color: #94a3b8;
}

/* ── Chart placeholder ───────────────────────────────────── */
#ChartWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
}

#ChartTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
}

/* ── Profile section ─────────────────────────────────────── */
#ProfileCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 28px;
}

#ProfileName {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
}

#ProfileRole {
    font-size: 13px;
    color: #64748b;
}

/* Separators */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #e2e8f0;
}
